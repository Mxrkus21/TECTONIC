# Provider is selected by the server, never by the browser UI.
DATA_COLLECTION_PROVIDER=mock

# Optional server-to-server protection. Leave empty only for local development.
DATA_COLLECTION_API_TOKEN=

# Google Drive provider
GOOGLE_DRIVE_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Microsoft Graph provider (client credentials)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_REGION=

# Optional OCR fallback. Authentication uses Google Application Default Credentials.
DOCUMENT_AI_ENABLED=false
GOOGLE_CLOUD_PROJECT=
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
